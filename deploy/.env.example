# Public browser/API hostname. Traefik obtains its certificate with ACME.
CONTROL_DOMAIN=manage.example.com

# Agent hostname. It must differ from CONTROL_DOMAIN because this route passes
# TLS through to control so control can authenticate each device certificate.
AGENT_DOMAIN=agents.example.com

# Let's Encrypt expiry and incident notifications.
ACME_EMAIL=admin@example.com

# Control image tag. Pin a release in production.
IMAGE_TAG=latest
