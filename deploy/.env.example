# Before ./setup.sh, give the audit archive storage of its own: data/backups
# must be on a different filesystem from the SQLite database under data/control.
# Mount a second disk, an NFS or NAS export, or any remote-backed volume there,
# or point that path at it:
#
#     mkdir -p data && ln -s /srv/power-manage-archive data/backups
#
# This is a requirement, not a recommendation. The archive holds the anchors and
# archived chain prefixes that prove the audit log was not rewritten, so control
# compares the two filesystems at startup and refuses to run when they match.
# Nothing in this file or in config/control.env turns that off, and setup.sh
# refuses to render a colliding configuration in the first place.

# Public browser/API hostname. Traefik obtains its certificate with ACME.
CONTROL_DOMAIN=manage.example.com

# Agent hostname. It must differ from CONTROL_DOMAIN because this route passes
# TLS through to control so control can authenticate each device certificate.
AGENT_DOMAIN=agents.example.com

# Let's Encrypt expiry and incident notifications.
ACME_EMAIL=admin@example.com

# How Let's Encrypt proves you own the two hostnames: http01 (the default when
# unset) answers on port 80, so it needs this host reachable from the internet
# there. Use dns01 when it is not — behind CGNAT, on a residential line with
# port 80 blocked, or on a private network — and Traefik writes the challenge
# record into your DNS zone instead. Any other value is refused.
#ACME_CHALLENGE=dns01
#
# dns01 only: the lego provider code for the DNS host of both zones. The zone
# must actually be served by that provider, not merely registered there.
#ACME_DNS_PROVIDER=hetzner
#
# dns01 also needs the provider's credentials in config/traefik-dns.env, which
# is yours to write and is never printed or copied. Traefik reads it directly:
#
#     install -m 600 /dev/null config/traefik-dns.env
#     printf 'HETZNER_API_KEY=%s\n' "$key" >> config/traefik-dns.env
#
# setup.sh refuses a dns01 run when that file is missing, empty, or readable by
# other accounts. Its propagation checks are pinned to public resolvers, so a
# split-horizon view of the zone at home cannot stall the certificate order.

# Control image tag. Pin a release in production.
IMAGE_TAG=latest
